          1 / number of rows in table                        PCOUNT  =                    0 / size of special data area                      GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                    1 / number of fields in each row                   TTYPE1  = 'COMPRESSED_DATA'    / label for field   1                            TFORM1  = '1PB     '           / data format of field: variable length array    ZIMAGE  =                    T / extension contains compressed image            ZBITPIX =                    8 / data type of original image                    ZNAXIS  =                    1 / dimension of original image                    ZNAXIS1 =                  380 / length of original image axis                  ZTILE1  =                  380 / size of tiles to be compressed                 ZCMPTYPE= 'RICE_1  '           / compression algorithm                          ZNAME1  = 'BLOCKSIZE'          / compression block size                         ZVAL1   =                   32 / pixels per block                               ZNAME2  = 'BYTEPIX '           / bytes per pixel (1, 2, 4, or 8)                ZVAL2   =                    1 / bytes per pixel (1, 2, 4, or 8)                EXTNAME = 'ICCProfile'                                                          END                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                