{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openfits",
  "version": "0.3.0",
  "description": "C++20 library for reading and writing FITS files",
  "homepage": "https://github.com/astroformats/openfits",
  "license": "Apache-2.0",
  "supports": "(windows | linux | osx) & (x64 | arm64) & !uwp",
  "dependencies": [
    "zlib",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "tbb": {
      "description": "Parallel work with oneTBB",
      "dependencies": [
        "tbb"
      ]
    }
  }
}
