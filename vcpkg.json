{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "openfits",
  "description": "Development manifest of OpenFITS: the dependencies of a local build",
  "homepage": "https://github.com/astroformats/openfits",
  "license": "Apache-2.0",
  "builtin-baseline": "3b0aa5ade4cccdbd08bb3fad308328e5a85a9172",
  "dependencies": [
    "zlib"
  ],
  "default-features": [
    "tests"
  ],
  "features": {
    "tbb": {
      "description": "oneTBB, for OPENFITS_WITH_TBB",
      "dependencies": [
        "tbb"
      ]
    },
    "tests": {
      "description": "GoogleTest, for OPENFITS_BUILD_TESTS",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmarks": {
      "description": "Google Benchmark, for OPENFITS_BUILD_BENCHMARKS",
      "dependencies": [
        "benchmark"
      ]
    }
  }
}
